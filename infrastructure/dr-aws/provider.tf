terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0.0"
    }
    null = {
      source  = "hashicorp/null"
      version = ">= 3.0.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = ">= 4.0.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.0.0"
    }
  }
}

# primary DC region - used for instance discovery + AMI snapshots
provider "aws" {
  region = var.dc_region
}

# DR target region - everything else gets built here
provider "aws" {
  alias  = "dr"
  region = var.dr_region
}
