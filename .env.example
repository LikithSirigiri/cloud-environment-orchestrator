# Copy this to .env and fill in real values. Never commit the real .env.

# Microsoft Entra ID (Azure AD) app registration used for login.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Must exactly match a Redirect URI registered on the app (Entra ID -> App
# registrations -> your app -> Authentication) -- e.g. https://your-domain.com/auth/callback
AZURE_AD_REDIRECT_URI=

# Comma-separated list of emails that always have admin access, regardless of what's in the DB
ADMIN_EMAILS=

# Azure Storage Account used as the Terraform remote state backend (must already exist).
# Each client+provider gets its own blob key under this account/container, so DR runs
# for different clients can proceed concurrently without colliding.
# Paste the full connection string from the Storage Account's "Access keys" blade --
# the backend parses AccountName/AccountKey out of it itself.
TF_STATE_CONNECTION_STRING=
TF_STATE_CONTAINER=

# Separate blob container (same storage account above) for New Environment
# deployment state -- required for New Environment (both Azure and AWS), not DR.
TF_STATE_CONTAINER_NEW_ENV=

# 32-byte key (64 hex chars) used to encrypt the Service Principal / AWS credentials
# stored per New Environment deployment, so a later destroy/edit can reuse the exact
# credentials that created it instead of requiring them to be retyped. Generated with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Keep this secret and stable -- rotating it makes previously-stored credentials
# undecryptable (destroy/edit then falls back to asking for them again).
CREDENTIALS_ENCRYPTION_KEY=

# Docker registry New Environment's app-setup step logs into on the VMs/instances
# to pull microservice images -- required once Stage 2 (application setup) runs,
# for both Azure and AWS.
DOCKER_REGISTRY_ADDRESS=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Break-glass admin login (bypasses Azure AD) -- /login/manual on the frontend.
# Hash is base64-encoded (not the raw "$2a$12$..." bcrypt string) -- docker-compose's
# env_file loading interpolates "$" + letter sequences as "${VAR}" references and
# silently blanks them out when undefined, corrupting a raw bcrypt hash. Base64 has
# no "$" to trip that. Generate with:
# node -e "console.log(Buffer.from(require('bcryptjs').hashSync('yourpassword', 12), 'utf-8').toString('base64'))"
FALLBACK_ADMIN_USERNAME=
FALLBACK_ADMIN_PASSWORD_HASH_B64=
FALLBACK_JWT_SECRET=

# Optional -- port the combined API+UI process listens on inside the container. Defaults to 3000.
PORT=3000
